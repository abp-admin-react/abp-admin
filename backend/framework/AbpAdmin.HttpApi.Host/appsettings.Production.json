{
  // 生产叠加：非 Development 加载。同名键覆盖基线。
  // 库真串：ConnectionStrings__Default（须含 Timezone=UTC，密码勿写本文件）。
  // Redis 真串：Redis__Configuration（password= 写在串内，或只放 secrets）。
  "SignalR": {
    // 多实例实时广播必须 Redis backplane；依赖 Redis:IsEnabled + Configuration 可达。
    // 覆盖：SignalR__UseRedisBackplane。
    "UseRedisBackplane": true
  },
  "Redis": {
    // 多实例必须 true。Configuration 不在本文件写死真密码。
    // 覆盖：Redis__IsEnabled、Redis__Configuration（格式见 Configuration/App.json）。
    "IsEnabled": true
  },
  "Quartz": {
    // 任务持久化；库串 ConnectionStrings:Default（Timezone=UTC）。覆盖：Quartz__UsePersistentStore。
    "UsePersistentStore": true
  }
}
