{
  // 生产环境叠加配置：非 Development 默认加载本文件，同名键覆盖 appsettings.json。
  // 下面三项都是"多实例横向扩展"的强制项：实时广播/锁与签名密钥集中到 Redis、定时任务
  // 持久化防跨实例重复触发。单实例部署若保持这三项默认，需保证 Redis:Configuration
  // 指向真实可达的实例（backplane 惰性建连，Redis 不可达时实时推送退化为进程内广播）。
  "SignalR": {
    // 跨实例实时广播必须走 Redis backplane：实例 A 上的用户要能收到实例 B 推送的消息，
    // 内存 backplane 只在本进程内有效。依赖 Redis 连接配置。
    "UseRedisBackplane": true
  },
  "Redis": {
    // 分布式锁 + DataProtection 签名密钥集中到 Redis（键名 AbpAdmin:DataProtection-Keys:{环境名}）：
    // 不开则锁退化为进程内、签名密钥留在本地文件系统——多实例下机器 A 签发的令牌机器 B
    // 验不过（宿主启动初始化时会对该姿态打 Warning）。真实连接串由部署环境以环境变量
    // Redis__Configuration 覆盖；单实例且无 Redis 的部署应显式改回 false 并同时关
    // UseRedisBackplane。
    "IsEnabled": true
  },
  "Quartz": {
    // 定时任务持久化到数据库（qrtz_* 表由迁移器幂等建表，见 QuartzTablesEnsurer）：
    // 多实例不重复触发同一作业、实例重启不丢任务。
    "UsePersistentStore": true
  }
}
