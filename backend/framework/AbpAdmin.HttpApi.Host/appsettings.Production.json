{
  // 生产环境叠加：ASPNETCORE_ENVIRONMENT=Production（或非 Development）时加载。
  // 同名键覆盖 appsettings.json / Configuration 基线。
  // Redis 连接串用环境变量 Redis__Configuration；勿把密码写进本文件。
  // 下面三项是多实例横向扩展强制项；单实例无 Redis 时应显式改回 false 并关 UseRedisBackplane。
  "SignalR": {
    // 跨实例实时广播必须走 Redis backplane。内存 backplane 只在本进程有效。
    // 依赖 Redis:Configuration 可达。覆盖：SignalR__UseRedisBackplane。
    "UseRedisBackplane": true
  },
  "Redis": {
    // 分布式锁 + DataProtection 签名密钥集中到 Redis（键 AbpAdmin:DataProtection-Keys:{环境}）。
    // false：锁进程内、密钥落本地文件 → 多实例令牌互验失败（启动 Warning）。
    // 覆盖：Redis__IsEnabled、Redis__Configuration。
    "IsEnabled": true
  },
  "Quartz": {
    // 任务持久化到 DB（qrtz_*，迁移器幂等建表）。多实例不重复触发、重启不丢任务。
    // 覆盖：Quartz__UsePersistentStore。
    "UsePersistentStore": true
  }
}
