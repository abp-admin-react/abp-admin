<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <RootNamespace>AbpAdmin</RootNamespace>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'AbpAdmin.HttpApi.Host' " />

  <ItemGroup>
    <!-- 单测直读中间件门限谓词（NV-16 回归锁）：internal 静态方法的路径归一化语义要钉死 -->
    <InternalsVisibleTo Include="AbpAdmin.HttpApi.Host.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.UI" />
    <PackageReference Include="IdentityModel" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <!-- T5：ES 官方 Serilog Sink（运行日志进 ES）；业务客户端走 AbpAdmin.Elasticsearch 项目引用 -->
    <PackageReference Include="Elastic.Serilog.Sinks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.MultiTenancy" />
    <PackageReference Include="Volo.Abp.Autofac" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" />
    <PackageReference Include="Volo.Abp.Swashbuckle" />
    <PackageReference Include="Volo.Abp.Caching.StackExchangeRedis" />
    <PackageReference Include="Volo.Abp.DistributedLocking" />
    <PackageReference Include="DistributedLock.Redis" />
    <!-- 多实例：DataProtection 签名密钥持久化到 Redis（机器 A 签的 token 机器 B 要能验） -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <!-- T3.2 SignalR 实时推送 + Redis backplane -->
    <PackageReference Include="Volo.Abp.AspNetCore.SignalR" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <!-- T3.3 cron 定时作业：worker 调度器换 Quartz（一次性队列作业不受影响）。
         序列化器包 Volo.Abp.Quartz 不带，必须显式引。 -->
    <PackageReference Include="Volo.Abp.BackgroundWorkers.Quartz" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" />
    <!-- T2.7 / T4.5: 外部登录 OAuth providers -->
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
    <PackageReference Include="AspNet.Security.OAuth.Weixin" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbpAdmin.Application\AbpAdmin.Application.csproj" />
    <ProjectReference Include="..\AbpAdmin.HttpApi\AbpAdmin.HttpApi.csproj" />
    <ProjectReference Include="..\AbpAdmin.EntityFrameworkCore\AbpAdmin.EntityFrameworkCore.csproj" />
    <!-- T5：ES 辅助存储模块（宿主级基础设施，DbMigrator 不感知） -->
    <ProjectReference Include="..\AbpAdmin.Elasticsearch\AbpAdmin.Elasticsearch.csproj" />
    <!-- 自包含业务模块样板（modules/ 业务板块区）。新增业务模块：加这一行引用 + AbpAdminHttpApiHostModule 的 DependsOn 一行 -->
    <ProjectReference Include="..\..\modules\AbpAdmin.Biz.Template\AbpAdmin.Biz.Template.csproj" />
    <!-- Webhook 模块（自包含：订阅/投递/发送记录，独立 History 表） -->
    <ProjectReference Include="..\AbpAdmin.Webhooks\AbpAdmin.Webhooks.csproj" />
    <ProjectReference Include="..\..\modules\AbpAdmin.Collection\AbpAdmin.Collection.csproj" />
    <ProjectReference Include="..\..\modules\AbpAdmin.Ordering\AbpAdmin.Ordering.csproj" />
    <ProjectReference Include="..\..\modules\AbpAdmin.Ledger\AbpAdmin.Ledger.csproj" />
    <ProjectReference Include="..\..\modules\AbpAdmin.TokenGateway\AbpAdmin.TokenGateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Studio.Client.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>


  <ItemGroup>
    <!-- Host Configuration/*.json baseline; copy to output for run/publish -->
    <Content Update="Configuration\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>


