{
  // 开发环境叠加：ASPNETCORE_ENVIRONMENT=Development 时加载，同名键覆盖 Configuration/*.json 与 appsettings.json。
  // 覆盖示例：App__CorsOrigins（环境变量优先于本文件）。
  "App": {
    // 开发期多前端端口（含 8002）只放这里；基线 Cors.json 不含 8002。
    // 与 Configuration/Cors.json 合并策略=整键覆盖（不是数组 append）。
    "CorsOrigins": "http://localhost:8000,https://localhost:8000,http://*.localhost:8000,http://localhost:8004,http://localhost:8006,http://localhost:8002",
    "RedirectAllowedUrls": "http://localhost:8000,http://demo.localhost:8000,http://localhost:8004,http://localhost:8006,http://localhost:8002"
  },
  "Serilog": {
    "MinimumLevel": {
      // 开发默认 Debug；勿带到 Production。
      "Default": "Debug"
    }
  },
  "Mailing": {
    // false=不发真实邮件（控制台/空实现）。联调真邮改为 true 并配好 Mailing SMTP（secrets）。
    "UseRealSender": false
  },
  "OpenIddict": {
    "Applications": {
      "AbpAdmin_App": {
        // 额外回调（租户 demo、8006、8002）。须同时出现在 RedirectAllowedUrls。
        "ExtraRedirectUris": [
          "http://localhost:8000",
          "http://localhost:8000/user/callback",
          "http://demo.localhost:8000",
          "http://demo.localhost:8000/user/callback",
          "http://localhost:8006",
          "http://localhost:8006/user/callback",
          "http://localhost:8002",
          "http://localhost:8002/user/callback"
        ],
        "ExtraPostLogoutRedirectUris": [
          "http://localhost:8000",
          "http://localhost:8000/",
          "http://demo.localhost:8000",
          "http://demo.localhost:8000/user/login",
          "http://localhost:8006",
          "http://localhost:8006/",
          "http://localhost:8002"
        ]
      },
      // 仅开发 CLI 客户端。ClientSecret 为开发专用，禁止进 Production / 禁止提交到非 Dev 文件。
      "AbpAdmin_TestCli": {
        "ClientId": "AbpAdmin_TestCli",
        "ClientSecret": "1q2w3E*test-cli-dev-only"
      }
    }
  },
  "Identity": {
    // 允许种子默认管理员口令。生产必须 false（或根本不加载本文件）。
    "AllowDefaultAdminPassword": true
  }
}
