{
  // 开发环境叠加配置：ASPNETCORE_ENVIRONMENT=Development 时加载，同名键覆盖 appsettings.json。
  "Serilog": {
    "MinimumLevel": {
      // 开发期整体放开到 Debug（含自研 AbpAdmin.* 命名空间），便于排查问题；
      // 基座文件的 Override（EF Core=Warning 等）按命名空间层级继续生效。
      "Default": "Debug"
    }
  },
  "Mailing": {
    // T3.5：开发环境默认不真发邮件（Domain 层会把 IEmailSender 换成 NullEmailSender 并打 Warning）。
    // 本地联调真实 SMTP 时改为 false → true，并在 SettingUi 配好 Abp.Mailing.Smtp.* 。
    "UseRealSender": false
  },
  // 开发专属 OIDC 通道（生产环境不加载本文件 → 不会种进生产库）：
  // - AbpAdmin_TestCli：ROPC 机密客户端，脚本化/E2E 测试通道（SPA 客户端已禁用 password grant）。
  //   密钥是公开的开发占位值；生产环境如确需脚本通道，经环境变量注入真实密钥后再启用本节。
  // - ExtraRedirectUris/ExtraPostLogoutRedirectUris：demo 租户子域名与多前端端口的开发回调。
  "OpenIddict": {
    "Applications": {
      "AbpAdmin_App": {
        "ExtraRedirectUris": [
          "http://demo.localhost:8000",
          "http://demo.localhost:8000/user/callback",
          "http://localhost:8006",
          "http://localhost:8006/user/callback"
        ],
        "ExtraPostLogoutRedirectUris": [
          "http://demo.localhost:8000",
          "http://demo.localhost:8000/user/login",
          "http://localhost:8006",
          "http://localhost:8006/"
        ]
      },
      "AbpAdmin_TestCli": {
        "ClientId": "AbpAdmin_TestCli",
        "ClientSecret": "1q2w3E*test-cli-dev-only"
      }
    }
  },
  "Identity": {
    // 开发环境显式允许种子 admin 使用模板公开默认口令（开箱即用）；生产环境不加载本键，
    // AbpAdminDbMigrationService 对默认口令直接 fail-fast——必须注入 Identity__AdminPassword。
    "AllowDefaultAdminPassword": true
  }
}
