{
  "$schema": "https://json.schemastore.org/appsettings.json",

  // =============================================================================
  // Host 基础设施基线：一个关注点一个文件（本目录 *.json 按文件名字母序加载，*.example 不加载）
  //   App.json         对外地址 / 日志开关 / 健康检查
  //   Cache.json       分布式缓存前缀 / Redis / SignalR
  //   Cors.json        CORS 与登录回跳白名单
  //   Database.json    数据库连接串（含密码，不入库；模板见 Database.json.example）
  //   OpenIddict.json  OIDC 客户端与 AuthServer（非敏感部分）
  //   Quartz.json      后台任务调度
  //   Security.json    证书口令 / 字符串加密口令（不入库；模板见 Security.json.example）
  // 总加载顺序（Program.cs）：appsettings.json → Configuration/*.json → appsettings.{Env}.json
  //   → appsettings.secrets.json → 环境变量（双下划线分层，如 App__SelfUrl）。后者覆盖前者。
  // launchSettings.json 只决定本机监听端口，不是 SelfUrl/Authority/Cors 的真源。
  // 时间：代码写死 AbpClockOptions.Kind=Utc（非 JSON 键），API 时间带 Z。
  // =============================================================================

  "App": {
    "SelfUrl": "https://localhost:44300", // 本 Host 对外自宣 URL（scheme+host+port），OAuth issuer、健康检查绝对地址依赖它；默认 https://localhost:44300；覆盖 App__SelfUrl；与实际监听不一致 → 回调/Swagger 连错主机
    "SpaUrl": "http://{0}.localhost:8000", // SPA 租户子域模板，{0}=租户名；默认 http://{0}.localhost:8000；改端口须同步 Cors.json；覆盖 App__SpaUrl
    "EnablePiiLogging": false, // 日志是否输出 PII：true|false；默认 false；生产必须 false；覆盖 App__EnablePiiLogging
    "EnableSecurityArtifactLogging": false, // 是否把令牌等安全工件写日志：true|false；默认 false；生产必须 false
    "HealthCheckUrl": "/health-status", // 健康检查路径（以 / 开头）；默认 /health-status；compose 健康探针依赖它
    "InstanceDiscriminator": "" // 多实例时缓存/锁键后缀：任意短字符串；默认空=单实例；覆盖 App__InstanceDiscriminator
  }
}
