{
  "$schema": "https://json.schemastore.org/appsettings.json",

  // =============================================================================
  // 数据库连接（模板）。本机：复制为同目录 Database.json 并把 CHANGE_ME 换成真密码。
  // Database.json 已在 .gitignore / .dockerignore，不入库、不进镜像。
  // 容器 / 生产：不放文件，用环境变量 ConnectionStrings__Default 整串注入（见 docker-compose.yml）。
  // 也可继续用 appsettings.secrets.json 覆盖（加载顺序在本目录之后）。
  //
  // Default 串内各键（Npgsql，分号分隔，键名大小写不敏感）：
  //   Host                         数据库主机名或 IP；默认 localhost；改错 → 连错库 / 迁移失败
  //   Port                         端口；默认 5432；改错 → 连接拒绝
  //   Database                     库名；默认 abpadmin；改错 → 连到空库或别的项目库
  //   Username                     登录用户；默认 postgres；改错 → 鉴权失败
  //   Password                     密码；模板 CHANGE_ME，真值只放 Database.json / secrets / 环境变量；不要打印到日志或群里
  //   Timezone                     会话时区，必须 UTC（与 Clock.Kind=Utc、API 时间带 Z、对账 [start,end) 对齐）；写成本地时区 → 过账时间/对账错位
  //   Maximum Pool Size            连接池上限，正整数；默认 100；过大 → 占满 PG max_connections；过小 → 请求排队超时
  //   Minimum Pool Size            池内常驻下限，≥0；默认 0；过大 → 空闲也占连接
  //   Timeout                      建立连接超时（秒），≥0；默认 30；过小 → 网络抖动即失败
  //   Keepalive                    TCP keepalive 间隔（秒），0=关闭；默认 30；防中间设备静默断开空闲连接
  //   Connection Idle Lifetime     池内空闲连接最长存活（秒）；默认 300；过短 → 频繁建连；过长 → 持有失效连接
  //   Connection Pruning Interval  空闲连接修剪扫描间隔（秒）；默认 10；须小于 Idle Lifetime
  // =============================================================================

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=abpadmin;Username=postgres;Password=CHANGE_ME;Timezone=UTC;Maximum Pool Size=100;Minimum Pool Size=0;Timeout=30;Keepalive=30;Connection Idle Lifetime=300;Connection Pruning Interval=10" // 主库连接串，各键见上；会被环境变量 ConnectionStrings__Default 覆盖（整串）；设计时工厂（dotnet ef）也读本文件
  }
}
