{
  // =============================================================================
  // CORS / 登录回跳白名单（与 App.json 同属 Host 入口基线）
  // -----------------------------------------------------------------------------
  // 真源：本文件 + appsettings.Development.json（开发额外端口如 8002 整键覆盖，非 append）。
  // launchSettings 不是真源。改前端端口：本文件 → Dev → OpenIddict ExtraRedirectUris → 库 RedirectUris。
  // 环境变量：App__CorsOrigins、App__RedirectAllowedUrls（逗号分隔）。
  // =============================================================================

  "App": {
    // 允许跨域调用 Host API 的前端原点。支持 http://*.localhost:8000。
    // 默认含 8000/8004/8006；8002 仅 Development。配错 → 浏览器 CORS 失败。
    "CorsOrigins": "http://localhost:8000,https://localhost:8000,http://*.localhost:8000,http://localhost:8004,http://localhost:8006",

    // 登录后允许回跳的 URL 前缀。须覆盖实际 SPA 原点；缺一项 → 登录后无法回前端。
    "RedirectAllowedUrls": "http://localhost:8000,http://demo.localhost:8000,http://localhost:8004,http://localhost:8006"
  }
}
