{
  // ===== 应用与认证基础（SelfUrl/Cors/OpenIddict/AuthServer/连接串/Redis）已迁到 Configuration/ =====
  // Program.cs 扫描 Configuration/*.json 作为基线；本文件只留业务与运维叠加项。
  // 审计日志：GET 默认不记（量大且幂等），写操作与敏感动作才进审计表。
  // RetentionDays：保留天数，LogRetentionBackgroundWorker 每日批删到期行
  //（AbpAuditLogActions/AbpEntityChanges 库级联随删）。缺省/0 = 永不清理；出厂建议 90。
  "Auditing": {
    "IsEnabledForGetRequests": false,
    "RetentionDays": 90
  },
  "OperationLogs": {
    "RetentionDays": 90
  },
  "LogRetention": {
    "BatchSize": 1000
  },
  "IpRegion": {
    "DbPath": "../../etc/ip2region/ip2region_v4.xdb",
    "DbPathV6": "../../etc/ip2region/ip2region_v6.xdb"
  },
  "Elasticsearch": {
    "IsEnabled": false,
    "Url": "http://127.0.0.1:9200",
    "Username": "elastic",
    "Password": "",
    "LogDataStream": "logs-abpadmin-default"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 104857600,
                "retainedFileCountLimit": 30,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {LogUniqueId}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {LogUniqueId}{NewLine}{Exception}"
            }
          ]
        }
      }
    ]
  },
  "Database": {
    "AutoMigrateOnStartup": true
  },
  "Blob": {
    "Provider": "Database",
    "FileSystem": {
      "BasePath": "App_Data/blobs",
      "AppendContainerNameToBasePath": true
    },
    "Aliyun": {
      "AccessKeyId": "",
      "AccessKeySecret": "",
      "Endpoint": "",
      "ContainerName": "",
      "CreateContainerIfNotExists": true
    },
    "Aws": {
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Region": "",
      "ServiceURL": "",
      "ContainerName": "",
      "CreateContainerIfNotExists": true,
      "UseCredentials": true
    },
    "Minio": {
      "EndPoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "",
      "WithSSL": false,
      "CreateBucketIfNotExists": true
    }
  },
  "FileManagement": {
    "MaxByteSizeForEachFile": 104857600,
    "MaxByteSizeForEachUpload": 209715200,
    "MaxFileQuantityForEachUpload": 20,
    "AllowOnlyConfiguredFileExtensions": true,
    "GetDownloadInfoTimesLimitEachUserPerMinute": 60,
    "AllowedFileExtensions": [
      ".jpg", ".jpeg", ".png", ".gif", ".webp", ".pdf",
      ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
      ".txt", ".md", ".csv", ".zip"
    ]
  },
  "Gdpr": {
    "RequestTimeInterval": "1.00:00:00",
    "MinutesForDataPreparation": "01:00:00"
  },
  "Imaging": {
    "CompressQuality": 80,
    "ResizeQuality": 80,
    "AvatarSize": 256,
    "ThumbnailMaxWidth": 256,
    "ThumbnailMaxHeight": 256,
    "ProcessTimeout": "00:00:15"
  },
  "CookieConsent": {
    "IsEnabled": true,
    "CookiePolicyUrl": "/cookie-policy",
    "PrivacyPolicyUrl": "/privacy-policy"
  },
  "HttpRemote": {
    "Profiler": false
  },
  "Webhooks": {
    "AllowIntranetTargets": false
  },
  "HttpProbe": {
    "AllowIntranetTargets": false
  },
  "Sms": {
    "AllowIntranetTargets": false
  },
  "Mailing": {
    "SecureSocketOption": null
  },
  "OperationRateLimiting": {
    "IsEnabled": true,
    "Login": {
      "IpMaxCount": 20,
      "IpDurationMinutes": 15,
      "EmailMaxCount": 5,
      "EmailDurationMinutes": 15
    },
    "TokenEndpoint": {
      "IpMaxCount": 300,
      "IpDurationMinutes": 5
    },
    "SmsVerificationCode": {
      "MaxCount": 3,
      "DurationHours": 1
    },
    "SmsNotification": {
      "MaxCount": 20,
      "DurationHours": 1
    },
    "EmailVerificationCode": {
      "MaxCount": 5,
      "DurationHours": 1,
      "IpMaxCount": 30
    },
    "VerificationCodeVerify": {
      "MaxCount": 5,
      "DurationMinutes": 10,
      "IpMaxCount": 30
    },
    "TwoFactorCode": {
      "MaxCount": 5,
      "DurationMinutes": 10
    },
    "AuditLogExport": {
      "MaxCount": 10,
      "DurationDays": 1
    },
    "FileShareDownload": {
      "IpMaxCount": 30,
      "IpDurationMinutes": 1
    },
    "GdprDownload": {
      "IpMaxCount": 10,
      "IpDurationMinutes": 1
    },
    "CaptchaImage": {
      "IpMaxCount": 60,
      "IpDurationMinutes": 5
    }
  },
  "Collection": {
    "Chain": {
      "ScanEnabled": false,
      "SweepEnabled": false,
      "ScanIntervalSeconds": 20,
      "SweepIntervalSeconds": 60,
      "RoundBudgetSeconds": 240,
      "Confirmations": 15,
      "BlockRange": 50,
      "RetryCooldownMinutes": 10,
      "RebroadcastGraceMinutes": 30,
      "SweepStuckMinutes": 120,
      "ScanBehindBlocks": 2000,
      "SkipRatioWindowMinutes": 1440,
      "SkipRatioThreshold": 0.9,
      "GasBnbAlertThreshold": 0.02,
      "FuelBnbLimit": 0.005
    }
  }
}
