{
  // =============================================================================
  // Host 业务/运维叠加（不含 SelfUrl/Cors/Authority/连接串真源）
  // -----------------------------------------------------------------------------
  // 真源端口与认证：Configuration/App.json + Cors.json。本文件只叠加审计、日志、Blob、
  // 限流、Collection 链上等。加载顺序见 App.json 头注释。
  // Clock：代码写死 UTC（AbpClockOptions.Kind），本文件无 Clock 节。
  // 敏感：库/Redis/ES/云密钥 → secrets 或环境变量，勿进基线。
  // 库连接串真源在 Configuration/Database.json（不入库，模板 Database.json.example，须含 Timezone=UTC）；本文件不含 ConnectionStrings。
  // =============================================================================

  // 审计日志：GET 默认不记（量大且幂等）；写操作与敏感动作进 AbpAuditLogs。
  // RetentionDays：保留天数；LogRetentionBackgroundWorker 每日批删到期行
  //（AbpAuditLogActions/AbpEntityChanges 级联）。0/缺省=永不清理。出厂 90。
  // 覆盖：Auditing__IsEnabledForGetRequests、Auditing__RetentionDays。
  "Auditing": {
    "IsEnabledForGetRequests": false,
    "RetentionDays": 90
  },
  // 操作日志保留天数，语义同 Auditing.RetentionDays。覆盖：OperationLogs__RetentionDays。
  "OperationLogs": {
    "RetentionDays": 90
  },
  // 每次清理批大小。过大占 IO；过小清理跟不上。默认 1000。覆盖：LogRetention__BatchSize。
  "LogRetention": {
    "BatchSize": 1000
  },
  // IP 属地库相对路径（相对 ContentRoot）。文件缺失则属地解析降级为空。
  "IpRegion": {
    "DbPath": "../../etc/ip2region/ip2region_v4.xdb",
    "DbPathV6": "../../etc/ip2region/ip2region_v6.xdb"
  },
  // Elasticsearch 日志汇聚。IsEnabled=false 时不连。密码走 secrets/Elasticsearch__Password。
  "Elasticsearch": {
    "IsEnabled": false,
    "Url": "http://127.0.0.1:9200",
    "Username": "elastic",
    "Password": "",
    "LogDataStream": "logs-abpadmin-default"
  },
  // Serilog：最低级别与输出。Dev 可在 appsettings.Development 把 Default 调到 Debug。
  // 合法级别：Verbose/Debug/Information/Warning/Error/Fatal。
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 104857600,
                "retainedFileCountLimit": 30,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {LogUniqueId}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {LogUniqueId}{NewLine}{Exception}"
            }
          ]
        }
      }
    ]
  },
  // 启动时是否自动 EF 迁移。生产可 false，改由发布流水线跑 migrator。覆盖：Database__AutoMigrateOnStartup。
  "Database": {
    "AutoMigrateOnStartup": true
  },
  // Blob 存储。Provider=Database|FileSystem|Aliyun|Aws|Minio。云密钥只走 secrets。
  "Blob": {
    "Provider": "Database",
    "FileSystem": {
      "BasePath": "App_Data/blobs",
      "AppendContainerNameToBasePath": true
    },
    "Aliyun": {
      "AccessKeyId": "",
      "AccessKeySecret": "",
      "Endpoint": "",
      "ContainerName": "",
      "CreateContainerIfNotExists": true
    },
    "Aws": {
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Region": "",
      "ServiceURL": "",
      "ContainerName": "",
      "CreateContainerIfNotExists": true,
      "UseCredentials": true
    },
    "Minio": {
      "EndPoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "",
      "WithSSL": false,
      "CreateBucketIfNotExists": true
    }
  },
  // 文件管理限额。MaxByte* 单位字节。AllowOnlyConfiguredFileExtensions=true 时扩展名白名单生效。
  // 体积闸门三层对账（调大 MaxByteSizeForEachUpload 时三处一起看）：
  //   ① 本节 = 容器限额（按文件净尺寸算）；
  //   ② Kestrel/FormOptions = ① + 1MiB 编码余量，AbpAdminHttpApiHostModule 自动跟随本节，
  //      生效值打在启动日志「上传体积限制」行；
  //   ③ 入口 nginx（web/nginx.conf /api/ client_max_body_size，现为 210m）= 部署侧手工
  //      同步，须 ≥ ①——漏改会先被 nginx 413，本节限额形同虚设。
  "FileManagement": {
    "MaxByteSizeForEachFile": 104857600,
    "MaxByteSizeForEachUpload": 209715200,
    "MaxFileQuantityForEachUpload": 20,
    "AllowOnlyConfiguredFileExtensions": true,
    "GetDownloadInfoTimesLimitEachUserPerMinute": 60,
    "AllowedFileExtensions": [
      ".jpg", ".jpeg", ".png", ".gif", ".webp", ".pdf",
      ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
      ".txt", ".md", ".csv", ".zip"
    ]
  },
  // GDPR：请求间隔与数据准备时限（TimeSpan 字符串）。过短会打爆导出队列。
  "Gdpr": {
    "RequestTimeInterval": "1.00:00:00",
    "MinutesForDataPreparation": "01:00:00"
  },
  // 图片压缩/头像/缩略图。Quality 1–100；ProcessTimeout 超时则处理失败。
  "Imaging": {
    "CompressQuality": 80,
    "ResizeQuality": 80,
    "AvatarSize": 256,
    "ThumbnailMaxWidth": 256,
    "ThumbnailMaxHeight": 256,
    "ProcessTimeout": "00:00:15"
  },
  "CookieConsent": {
    "IsEnabled": true,
    "CookiePolicyUrl": "/cookie-policy",
    "PrivacyPolicyUrl": "/privacy-policy"
  },
  // HttpRemote 性能分析。生产保持 false。
  "HttpRemote": {
    "Profiler": false
  },
  // 出站安全：是否允许 Webhook/探针/短信网关打到内网地址。生产必须 false（防 SSRF）。
  "Webhooks": {
    "AllowIntranetTargets": false
  },
  "HttpProbe": {
    "AllowIntranetTargets": false
  },
  "Sms": {
    "AllowIntranetTargets": false
  },
  // 邮件 SecureSocketOption：null=按框架默认；可设 StartTls/SslOnConnect 等。
  "Mailing": {
    "SecureSocketOption": null
  },
  // 操作限流。IsEnabled=false 全关（仅排障）。各子节 MaxCount + Duration* 为固定窗口
  //（FixedWindowRateLimitingRule，窗口起点=首次请求时刻，边界处可突发至约 2 倍阈值；
  // 需要滑窗/令牌桶时按 IOperationRateLimitingRule 扩展——注释必须与实现算法一致，
  // 本行曾误写为"滑动窗口"）。
  // 改太小：正常用户被 429；改太大：打爆登录/发码接口。
  "OperationRateLimiting": {
    "IsEnabled": true,
    "Login": {
      "IpMaxCount": 20,
      "IpDurationMinutes": 15,
      "EmailMaxCount": 5,
      "EmailDurationMinutes": 15
    },
    "TokenEndpoint": {
      "IpMaxCount": 300,
      "IpDurationMinutes": 5
    },
    "SmsVerificationCode": {
      "MaxCount": 3,
      "DurationHours": 1
    },
    "SmsNotification": {
      "MaxCount": 20,
      "DurationHours": 1
    },
    "EmailVerificationCode": {
      "MaxCount": 5,
      "DurationHours": 1,
      "IpMaxCount": 30
    },
    "VerificationCodeVerify": {
      "MaxCount": 5,
      "DurationMinutes": 10,
      "IpMaxCount": 30
    },
    "TwoFactorCode": {
      "MaxCount": 5,
      "DurationMinutes": 10
    },
    "AuditLogExport": {
      "MaxCount": 10,
      "DurationDays": 1
    },
    "FileShareDownload": {
      "IpMaxCount": 30,
      "IpDurationMinutes": 1
    },
    "GdprDownload": {
      "IpMaxCount": 10,
      "IpDurationMinutes": 1
    },
    "CaptchaImage": {
      "IpMaxCount": 60,
      "IpDurationMinutes": 5
    }
  },
  // Collection 链上扫块/归集（业务模块）。Host 未 DependsOn Collection 时本节无效。
  // ScanEnabled/SweepEnabled 默认 false；上线前确认 RPC/Gas 配置，误开会扫链烧 Gas。
  "Collection": {
    "Chain": {
      "ScanEnabled": false,
      "SweepEnabled": false,
      "ScanIntervalSeconds": 20,
      "SweepIntervalSeconds": 60,
      "RoundBudgetSeconds": 240,
      "Confirmations": 15,
      "BlockRange": 50,
      "RetryCooldownMinutes": 10,
      "RebroadcastGraceMinutes": 30,
      "SweepStuckMinutes": 120,
      "ScanBehindBlocks": 2000,
      "SkipRatioWindowMinutes": 1440,
      "SkipRatioThreshold": 0.9,
      "GasBnbAlertThreshold": 0.02,
      "FuelBnbLimit": 0.005
    }
  }
}
