<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- NU1608：Nethereum 4.29 声明 Logging.Abstractions <10.0.0，实际与 10.x 兼容
         （依赖约束未更新）；等 Nethereum 出新版后移除此抑制 -->
    <NoWarn>$(NoWarn);CS1591;NU1608</NoWarn>
    <!-- 依赖漏洞审计：NuGetAudit 关闭等于放弃唯一的自动检出通道。
         AuditMode=all 覆盖传递依赖，AuditLevel=low 让低危也现身（只观测，不阻断构建；
         阻断由 scripts/security-scan.sh 在 CI 里按严重度做）。
         注意：不要把门禁建在 restore 告警上（XML 注释写不下开关名，规则见
         scripts/security-scan.sh 第 1 道门禁）：同一份依赖图 restore 可报 0 Warning
         而 vulnerable 查询报出真实通告（实测不一致），CI 必须走后者。 -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
	<AbpProjectType>app</AbpProjectType>
  </PropertyGroup>

  <Target Name="NoWarnOnRazorViewImportedTypeConflicts" BeforeTargets="RazorCoreCompile">
    <PropertyGroup>
      <NoWarn>$(NoWarn);0436</NoWarn>
    </PropertyGroup>
  </Target>

</Project>