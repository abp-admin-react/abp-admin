<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear：屏蔽用户级/机器级 NuGet.Config 里的其他源，包只允许来自本文件声明的源（供应链加固） -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- 单源场景：`*` 已覆盖一切，不再罗列冗余的 Microsoft.*/Volo.* 模式（问题19 修复） -->
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
