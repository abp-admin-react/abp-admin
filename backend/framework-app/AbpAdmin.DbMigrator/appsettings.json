{
  // 迁移器是短生命周期一次性进程：Quartz 走内存调度即可；基线来自 Host Configuration/Quartz.json
  // （UsePersistentStore=false，此处显式钉住同值），生产多实例的持久化调度是宿主侧 appsettings.Production.json
  // 的事——迁移器刻意不加载该文件。
  "Quartz": {
    "UsePersistentStore": false
  },
  // 本文件只保留迁移器专属配置（Quartz / Identity）。
  // OpenIddict 客户端清单的单一事实来源是 HttpApi.Host/Configuration/OpenIddict.json（目录分区后
  // 已从其 appsettings.json 挪出）：Program.cs 按 Host appsettings → Host Configuration/*.json →
  // Host secrets → 本文件 → 环境变量 分层加载，种子代码读组合后的 OpenIddict:Applications 节，
  // 因此要加客户端/改回调地址只改 Configuration/OpenIddict.json 即可。
  // 数据库相关配置单一来源见 Program.cs 的 ConfigureAppConfiguration；
  // 生产/CI 一律用环境变量注入（ConnectionStrings__Default），优先级最高。
  "Identity": {
    // 问题12 修复：种子 admin 密码可覆盖（留空 = 使用 AbpAdminConsts.AdminPasswordDefaultValue 模板默认值）。
    // 生产部署应通过 appsettings.secrets.json / 环境变量 Identity__AdminPassword 注入强口令。
    "AdminPassword": ""
  }
}
