<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>AbpAdmin.Collection</RootNamespace>
    <!-- 自包含收款模块：收款单/余额/链上（M2/M5 落表）+ 渠道网关 + 集成服务实现，
         迁移记账表 __AbpAdminCollection_EFMigrationsHistory。
         本地化嵌入资源在本工程（契约工程不带本地化）——不开 GenerateEmbeddedFilesManifest
         时业务异常文案会退化成裸键。 -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\framework\AbpAdmin.EntityFrameworkCore\AbpAdmin.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\AbpAdmin.Collection.Contracts\AbpAdmin.Collection.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" />
    <PackageReference Include="Volo.Abp.Authorization" />
    <PackageReference Include="Volo.Abp.Localization" />
    <PackageReference Include="Volo.Abp.VirtualFileSystem" />
    <!-- 嵌入清单生成任务依赖此包（缺它则 GenerateEmbeddedFilesManifest 静默不生效） -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <!-- 微信收款走 EasyAbp PaymentService（Payment/PaymentItem 行 + 退款拦截守卫要读支付行项） -->
    <PackageReference Include="EasyAbp.PaymentService.Domain" />
    <!-- 链上（M5 计划第 5.6 节）：HD 派生与交易签名；本模块可用，Ordering 的边界测试禁止它经 Contracts 传导 -->
    <PackageReference Include="Nethereum.HdWallet" />
    <PackageReference Include="Nethereum.Signer" />
    <!-- 设置页 UI 元数据（第③层运行期参数的 WithUi 扩展在此包）与设置存储域层 -->
    <PackageReference Include="EasyAbp.Abp.SettingUi.Domain" />
    <PackageReference Include="Volo.Abp.SettingManagement.Domain" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Collection\*.json" />
  </ItemGroup>

</Project>
