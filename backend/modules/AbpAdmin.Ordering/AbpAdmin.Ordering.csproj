<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>AbpAdmin.Ordering</RootNamespace>
    <!-- 订单模块（单工程，无 Contracts 工程）：依赖 AbpAdmin.Collection.Contracts（只看契约）。
         直接引用收款实现、EasyAbp 或 Nethereum 即退回（架构测试查直接引用，计划第 2、10 节；
         经 AbpAdmin.EntityFrameworkCore 传递进来的 EasyAbp 包是框架工程既有的，不在此列）。
         迁移记账表 __AbpAdminOrdering_EFMigrationsHistory。本地化嵌入资源在本工程。 -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\framework\AbpAdmin.EntityFrameworkCore\AbpAdmin.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\AbpAdmin.Collection.Contracts\AbpAdmin.Collection.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" />
    <PackageReference Include="Volo.Abp.Authorization" />
    <PackageReference Include="Volo.Abp.Localization" />
    <PackageReference Include="Volo.Abp.VirtualFileSystem" />
    <!-- 嵌入清单生成任务依赖此包（缺它则 GenerateEmbeddedFilesManifest 静默不生效） -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <!-- 设置存储域层（Volo 包）。注意：订单工程不直接引用任何 EasyAbp 包（计划第 10 节，
         架构测试同时扫 ProjectReference 与 PackageReference）——WithUi 走框架
         AbpAdmin.Domain 的 SettingDefinitionUiExtensions（纯字符串参数），
         SettingUi 的 Tab 名挂链留在收款模块（其允许引用 EasyAbp），本模块设置页
         Tab 显示裸键 "Ordering"，M3 渠道设置页落地时一并处理 -->
    <PackageReference Include="Volo.Abp.SettingManagement.Domain" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Ordering\*.json" />
  </ItemGroup>

</Project>
