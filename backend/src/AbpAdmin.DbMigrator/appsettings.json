{
  // 迁移器是短生命周期一次性进程：Quartz 走内存调度即可；此键与 Host 的同名键各自独立
  // （不同进程各读各的），生产多实例的持久化调度在 appsettings.Production.json 开启。
  "Quartz": {
    "UsePersistentStore": false
  },
  // 本文件只保留迁移器专属配置（Quartz / Identity）。
  // OpenIddict 客户端清单已统一到 HttpApi.Host/appsettings.json（单一事实来源），本文件
  // 刻意不再重复：Program.cs 按 Host appsettings → Host secrets → 本文件 → 环境变量 分层
  // 加载，种子代码 OpenIddictDataSeedContributor 读组合后的 OpenIddict:Applications 节，
  // 因此要加客户端/改回调地址只改 Host 那份即可。
  // 数据库相关配置单一来源见 Program.cs 的 ConfigureAppConfiguration；
  // 生产/CI 一律用环境变量注入（Database__Provider / ConnectionStrings__Default），优先级最高。
  "Identity": {
    // 问题12 修复：种子 admin 密码可覆盖（留空 = 使用 AbpAdminConsts.AdminPasswordDefaultValue 模板默认值）。
    // 生产部署应通过 appsettings.secrets.json / 环境变量 Identity__AdminPassword 注入强口令。
    "AdminPassword": ""
  }
}
