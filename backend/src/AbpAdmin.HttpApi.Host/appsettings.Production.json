{
  // 生产环境叠加配置：非 Development 默认加载本文件，同名键覆盖 appsettings.json。
  // 下面两项都是"多实例横向扩展"的强制项——单实例部署保持 true 也无副作用。
  "SignalR": {
    // 跨实例实时广播必须走 Redis backplane：实例 A 上的用户要能收到实例 B 推送的消息，
    // 内存 backplane 只在本进程内有效。依赖 Redis 连接配置。
    "UseRedisBackplane": true
  },
  "Quartz": {
    // 定时任务持久化到数据库（建表脚本见 backend/etc/quartz/tables_postgres.sql）：
    // 多实例不重复触发同一作业、实例重启不丢任务。
    "UsePersistentStore": true
  }
}
