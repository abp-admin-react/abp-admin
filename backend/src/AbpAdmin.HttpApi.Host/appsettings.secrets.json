{
  // ===== 开发样本（入库，公开安全的本地默认值）=====
  // 本文件被 git 跟踪：内容只放公开无害的本地默认值，克隆后照抄即能跑通本地开发
  // （docker 同参起库命令见 ConnectionStrings 注释）。
  // 本机/内网真实凭据：直接改这个文件，然后执行一次
  //   git update-index --skip-worktree src/AbpAdmin.HttpApi.Host/appsettings.secrets.json
  // git 从此无视它的本地改动（git add -A 也不会带进去）；拉取遇到冲突时先
  // --no-skip-worktree 处理完再改回 skip。生产的等价注入方式是环境变量，
  // 键名层级用双下划线：ConnectionStrings__Default / AuthServer__CertificatePassPhrase /
  // Elasticsearch__Password。
  // 注意：更换 StringEncryption 口令后，存量 isEncrypted 设置项（SMTP/短信凭据等）
  // 需按 ABP NewPassPhrase 机制重加密，否则解密失败。
  "AuthServer": {
    // OpenIddict 签名证书口令（开发用自签证书）。
    "CertificatePassPhrase": "dev-only-change-me"
  },
  "StringEncryption": {
    // ABP 设置项加密口令（覆盖基座文件中的空值）。
    "DefaultPassPhrase": "dev-only-change-me"
  },
  "ConnectionStrings": {
    // 业务数据库（PostgreSQL，单提供程序）；与 CI 的 postgres 服务容器同参。
    // 本机零改动可跑：
    //   docker run -d --name abpadmin-pg -p 5432:5432 \
    //     -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=abpadmin postgres:16
    "Default": "Host=localhost;Port=5432;Database=abpadmin;Username=postgres;Password=postgres"
  },
  "DistributedCache": {
    // 单实例开发独占实例/独占库：留空即不隔离（与基座默认一致）；
    // 共享 Redis 上多应用隔离时改 AbpAdmin: 之类前缀，键形如 AbpAdmin:c:...
    "KeyPrefix": ""
  },
  "Redis": {
    // 分布式缓存 + 分布式锁 + DataProtection 签名密钥共用这条连接（惰性 SharedRedisConnection）：
    // 单实例开发默认 false（缓存走进程内存）；指向真实 Redis 时改 true，
    // defaultDatabase 建议专用库号（如 3）——所有键（c:*/t:* 缓存、DataProtection 密钥环）落该库。
    "IsEnabled": false,
    "Configuration": "127.0.0.1:6379"
  },
  "Elasticsearch": {
    // 日志 Sink 凭据：默认 false（日志只进控制台/文件）；指向真实集群时改 true。
    // 健康检查依赖它——IsEnabled=true 而集群不可达时 /health 会 503。
    "IsEnabled": false,
    "Url": "http://127.0.0.1:9200",
    "Username": "elastic",
    "Password": "CHANGE_ME"
  }
}
