<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>AbpAdmin.Biz.Template</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只依赖框架 EF 基建工程（连带 Domain/EFCore/迁移约定接口），业务归业务 -->
    <ProjectReference Include="..\AbpAdmin.EntityFrameworkCore\AbpAdmin.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <!-- migrations/ 下是两个独立编译的迁移程序集子工程（EF Core 每提供程序需要一个迁移程序集，
       无法并入本程序集），从本工程默认 glob 排除，防止迁移源码被重复编译进模块主程序集 -->
  <ItemGroup>
    <Compile Remove="migrations\**" />
    <EmbeddedResource Remove="migrations\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" />
    <PackageReference Include="Volo.Abp.Authorization" />
    <PackageReference Include="Volo.Abp.Localization" />
    <PackageReference Include="Volo.Abp.VirtualFileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\BizTemplate\*.json" />
  </ItemGroup>

</Project>
