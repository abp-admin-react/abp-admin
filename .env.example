# 复制为 .env 并填写设置加密口令。本机体验的管理员口令留空时使用 1q2w3E*。
IDENTITY_ADMIN_PASSWORD=
STRING_ENCRYPTION_PASSPHRASE=

# 端口与访问地址成对修改。
WEB_BIND=127.0.0.1
WEB_HOST_PORT=8000
WEB_PUBLIC_URL=http://localhost:8000

# 部门和声明类型演示。开启时为两个演示账号设置一个本地口令。
SEED_IDENTITY_UI_DEMO=false
IDENTITY_UI_DEMO_PASSWORD=

# 需要预填业务模板的示例项目时改为 true。
BIZ_TEMPLATE_SEED_SAMPLE_DATA=false
